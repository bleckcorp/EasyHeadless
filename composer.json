{
  "name": "easyheadless/bridge",
  "description": "Development tooling for the EasyHeadless WordPress bridge.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=1G"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
